{
  "expo": {
    "name": "Receipt Scanner",
    "slug": "receipt-recognition",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "receiptscanner",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pasichnyk.receiptscanner",
      "infoPlist": {
        "NSCameraUsageDescription": "Камера нужна, чтобы фотографировать чеки для распознавания.",
        "NSPhotoLibraryUsageDescription": "Доступ к галерее нужен, чтобы выбрать фото чека."
      }
    },
    "android": {
      "package": "com.pasichnyk.receiptscanner",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Камера нужна, чтобы фотографировать чеки для распознавания."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Доступ к галерее нужен, чтобы выбрать фото чека."
        }
      ],
      "expo-localization",
      "expo-asset",
      "expo-dev-client"
    ],
    "extra": {
      "eas": {
        "projectId": "aeadba75-abcb-4433-9d15-d19e79bd0b57"
      }
    },
    "owner": "volodymyr831"
  }
}
